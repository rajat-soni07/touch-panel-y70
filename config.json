{
  "display": "auto",
  "noFocus": true,
  "alwaysOnTop": true,
  "statusIntervalMs": 3000,

  "ui": {
    "page": "transparent",
    "card": "transparent",
    "dock": "#2A303E",
    "dockOpacity": 0.5,
    "text": "#1A1A1B",
    "name": "#161A25",
    "sub": "#131A2E",
    "track": "#24233A",
    "accent": "#DE6549",
    "ringWidth": 6,
    "ringTrackOpacity": 0.25,
    "tileText": "#F2F4F8",
    "tileSub": "rgba(242, 244, 248, 0.55)",
    "diskLabel": "All disks"
  },

  "sensors": {
    "cpuTemp": "Tctl|Tdie|CPU Package|CPU Die",
    "cpuTempMode": "avg",
    "fps": "Framerate|FPS",
    "fpsIgnore": "electron\\.exe|dwm\\.exe"
  },

  "discord": {
    "enabled": true,
    "maxMembers": 5
  },

  "games": {
    "enabled": true,
    "count": 15,
    "fillWithUninstalled": true,
    "exclude": [431960],
    "extra": [
      { "id": "re-requiem",    "name": "Resident Evil Requiem",         "exe": "D:\\Games\\Resident Evil Requiem\\re9.exe",                       "cover": "assets/covers/re-requiem.jpg" },
      { "id": "battlefield-6", "name": "Battlefield 6",                 "exe": "D:\\Games\\Battlefield 6\\bf6.exe",                               "cover": "assets/covers/battlefield-6.jpg" },
      { "id": "cod-mw4",       "name": "Call of Duty: Modern Warfare 4", "exe": "D:\\Games\\Call of Duty Modern Warfare 4\\!start_sp26.bat",     "process": "sp26-cod.exe", "cover": "assets/covers/cod-mw4.jpg" },
      { "id": "uncharted-4",   "name": "Uncharted 4",                   "exe": "D:\\Games\\Uncharted\\u4.exe",                                    "cover": "assets/covers/uncharted-4.jpg" },
      { "id": "valorant",      "name": "VALORANT",                      "exe": "D:\\Games\\Riot Games\\Riot Client\\RiotClientServices.exe", "args": "--launch-product=valorant --launch-patchline=live", "process": "VALORANT-Win64-Shipping.exe", "cover": "assets/covers/valorant.png" }
    ]
  },

  "buttons": [
    { "id": "snip",   "label": "Screenshot",    "icon": "assets/snipping-tool.png", "cmd": "start \"\" ms-screenclip:" },
    { "id": "tasks",  "label": "Task Manager",  "icon": "assets/task-manager.png",  "cmd": "start \"\" taskmgr" },
    { "id": "chrome", "label": "Chrome",        "icon": "assets/chrome.png",        "cmd": "start \"\" \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"" },
    { "id": "steam",  "label": "Steam",         "icon": "assets/steam.png",         "popup": "games", "cmd": "start \"\" steam://open/main" }
  ],

  "pageButtons": [
    {
      "id": "vpn",
      "type": "toggle",
      "size": "full",
      "label": "NordVPN",
      "icon": "shield",
      "onText": "Protected",
      "offText": "Not connected",
      "busyText": "Connecting…",
      "on":  { "cmd": "\"C:\\Program Files\\NordVPN\\NordVPN.exe\" -c" },
      "off": { "cmd": "\"C:\\Program Files\\NordVPN\\NordVPN.exe\" -d" },
      "status": { "type": "interface", "match": "nord" },
      "busyTimeoutMs": 25000
    },
    { "id": "vpn-de", "label": "Germany", "icon": "globe", "busy": "vpn", "cmd": { "cmd": "\"C:\\Program Files\\NordVPN\\NordVPN.exe\" -c -g \"Germany\"" } },
    { "id": "vpn-us", "label": "United States", "icon": "globe", "busy": "vpn", "cmd": { "cmd": "\"C:\\Program Files\\NordVPN\\NordVPN.exe\" -c -g \"United States\"" } },
    { "id": "lock",  "label": "Lock PC", "icon": "lock", "cmd": "rundll32.exe user32.dll,LockWorkStation" },
    { "id": "prev",  "label": "Previous",     "icon": "prev", "cmd": { "shell": "powershell", "cmd": "(New-Object -ComObject WScript.Shell).SendKeys([char]177)" } },
    { "id": "play",  "label": "Play / Pause", "icon": "play", "cmd": { "shell": "powershell", "cmd": "(New-Object -ComObject WScript.Shell).SendKeys([char]179)" } },
    { "id": "next",  "label": "Next",         "icon": "next", "cmd": { "shell": "powershell", "cmd": "(New-Object -ComObject WScript.Shell).SendKeys([char]176)" } },
    { "id": "voldown", "label": "Volume −", "icon": "voldown", "cmd": { "shell": "powershell", "cmd": "$s=New-Object -ComObject WScript.Shell; 1..5 | % { $s.SendKeys([char]174) }" } },
    { "id": "mute",    "label": "Mute",     "icon": "mute",    "cmd": { "shell": "powershell", "cmd": "(New-Object -ComObject WScript.Shell).SendKeys([char]173)" } },
    { "id": "volup",   "label": "Volume +", "icon": "volup",   "cmd": { "shell": "powershell", "cmd": "$s=New-Object -ComObject WScript.Shell; 1..5 | % { $s.SendKeys([char]175) }" } }
  ]
}
